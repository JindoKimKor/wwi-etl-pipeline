          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Orders (Fact)\Transform Orders\Get Orders Staging"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Get Orders Staging"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[Orders_Stage]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
  -- Surrogate Keys
  c.CustomerKey,
  l.LocationKey,
  p.ProductKey,
  sp.SalespersonKey,
  s.SupplierKey,
  d.DateKey, 

  -- Facts
  o.Quantity,
  o.UnitPrice,
  o.TaxRate,
  
  -- Calculated Measures
  (o.Quantity * o.UnitPrice) AS TotalBeforeTax,
  (o.Quantity * o.UnitPrice) * (1 + o.TaxRate) AS TotalAfterTax

FROM dbo.Orders_Stage o

-- 1. DATE JOIN 
INNER JOIN dbo.DimDate d
  ON CAST(o.OrderDate AS DATE) = d.DateValue

-- 2. LOCATION JOIN 
INNER JOIN dbo.DimLocation l 
  ON o.CityName = l.CityName 
  AND o.StateProvinceName = l.StateProvName
  AND o.CountryName = l.CountryName

-- 3. CUSTOMER JOIN (SCD Type 2)
INNER JOIN dbo.DimCustomers c 
  ON o.CustomerName = c.CustomerName 
  AND o.OrderDate &gt;= c.StartDate 
  AND (o.OrderDate &lt;= c.EndDate OR c.EndDate IS NULL)

-- 4. PRODUCT JOIN (SCD Type 2)
INNER JOIN dbo.DimProducts p 
  ON o.StockItemName = p.ProductName 
  AND o.OrderDate &gt;= p.StartDate 
  AND (o.OrderDate &lt;= p.EndDate OR p.EndDate IS NULL)

-- 5. SUPPLIER JOIN (SCD Type 2)
INNER JOIN dbo.DimSuppliers s 
  ON o.SupplierName = s.FullName 
  AND o.OrderDate &gt;= s.StartDate 
  AND (o.OrderDate &lt;= s.EndDate OR s.EndDate IS NULL)

-- 6. SALESPERSON JOIN (SCD Type 1)
INNER JOIN dbo.DimSalesPeople sp 
  ON o.LogonName = sp.LogonName;</property>
