          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Customers\Extract Customers\Get Customer Data"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Get Customer Data"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[Sales].[Customers]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    c.CustomerName,
    cc.CustomerCategoryName,
    
    -- Delivery Address Hierarchy
    dc.CityName AS DeliveryCityName,
    dsp.StateProvinceCode AS DeliveryStateProvCode,
    dct.CountryName AS DeliveryCountryName,
    
    -- Postal Address Hierarchy
    pc.CityName AS PostalCityName,
    psp.StateProvinceCode AS PostalStateProvCode,
    pct.CountryName AS PostalCountryName

FROM Sales.Customers c
LEFT JOIN Sales.CustomerCategories cc 
    ON c.CustomerCategoryID = cc.CustomerCategoryID

-- 1st Path: Resolve Delivery Location
LEFT JOIN Application.Cities dc 
    ON c.DeliveryCityID = dc.CityID
LEFT JOIN Application.StateProvinces dsp 
    ON dc.StateProvinceID = dsp.StateProvinceID
LEFT JOIN Application.Countries dct 
    ON dsp.CountryID = dct.CountryID

-- 2nd Path: Resolve Postal Location
LEFT JOIN Application.Cities pc 
    ON c.PostalCityID = pc.CityID
LEFT JOIN Application.StateProvinces psp 
    ON pc.StateProvinceID = psp.StateProvinceID
LEFT JOIN Application.Countries pct 
    ON psp.CountryID = pct.CountryID;</property>
                    <property
